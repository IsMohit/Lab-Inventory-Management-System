# Flask Backend Environment Variables

# Application Configuration
FLASK_ENV=production
DEBUG=False
SECRET_KEY=change-me-to-random-secret-key
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://mongo:27017/lims
MONGODB_TEST_URI=mongodb://localhost:27017/lims_test

# JWT Configuration
JWT_SECRET=change-me-to-random-jwt-secret
JWT_EXPIRATION_HOURS=24

# Firebase Configuration
# Get these from your Firebase project settings
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email@appspot.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
