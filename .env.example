# Docker and Containerization Environment Variables

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secure_password_change_me

# Flask Backend
FLASK_ENV=production
DEBUG=False
SECRET_KEY=your-random-secret-key-change-me
JWT_SECRET=your-random-jwt-secret-change-me
PORT=5000

# MongoDB Connection (for backend)
MONGODB_URI=mongodb://mongo:27017/lims

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email@appspot.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
